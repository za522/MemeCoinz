# Public fallback. Suitable for health checks and light local testing, not bulk ingestion.
SOLANA_RPC_URL=https://api.mainnet.solana.com

# Required for bounded historical backfills. It must retain the requested slots.
SOLANA_ARCHIVE_RPC_URL=

# Optional server-only provider credentials. Never prefix these with NEXT_PUBLIC_.
HELIUS_API_KEY=
SOLANA_TRACKER_API_KEY=
X_BEARER_TOKEN=
JUPITER_API_KEY=

# Explicit cost gate. Keep false until metered provider usage is reviewed.
TOKEN_ENRICHMENT_METERED_ENABLED=false

# Required by POST /api/coins/backfill, POST /api/collection/token, and POST /api/pipeline/run.
# Send it only as the server-side x-backfill-token request header.
BACKFILL_ADMIN_TOKEN=

# Optional Telegram delivery for validated shadow-model predictions only.
# No trade is submitted. Keep disabled until the bot, chat, threshold, and scheduler are reviewed.
MEMETRACE_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_PROBABILITY_THRESHOLD=0.80
PUBLIC_APP_URL=http://localhost:3000
